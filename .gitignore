node_modules/
**/node_modules/
.env.local
.env
package-lock.json
!mcp-server/package-lock.json
.DS_Store
*.tsbuildinfo
**/convex.json
convex/_generated/
apps/

# Claude Code — ALL of .claude is version-controlled (Laurent directive, task k170vg5r).
# What protects a workstation must be readable and reviewable by the fleet; a .claude
# file left untracked is invisible, unreviewed, and wiped on the next branch switch.
# The re-inclusion and its only exceptions live at the END of this file — after the
# repo-wide __pycache__/ + *.pyc rules — so the last-matching rule wins for .claude.
.playwright-mcp/
_archive/
mcp-server/dist/

# Compiled Python artefacts. NOT merely noise: a .pyc keeps the SOURCE STRINGS
# in its bytecode, so a committed .pyc goes on leaking identifiers long after the
# source has been purged -- and a directory-copy distribution ships whatever sits
# in the tree. Gitignoring is not enough on its own: the file has to actually be
# absent. (Day 130: the leak guard's own .pyc was published carrying 6 client-name
# hits in its bytecode, invisible to the guard because the guard refused to open it.)
__pycache__/
*.pyc

# .claude is tracked in full (task k170vg5r). Re-include everything under it,
# overriding the repo-wide __pycache__/ + *.pyc rules above for the .claude subtree.
# The middle line (!.claude/**/) is MANDATORY: without re-including the directories
# themselves, git never descends into an excluded dir and the globs below match nothing.
!.claude/
!.claude/**/
!.claude/**
# The only exceptions — regenerated caches and run locks: not content, rebuilt on their own.
.claude/**/__pycache__/
.claude/**/*.pyc
.claude/**/.pytest_cache/
.claude/scheduled_tasks.lock
.themis-seats.local.json

# credential backups — never committable
.env*.bak*
.env*bak*

# local tooling scratch (grok agents/rules)
.grok/
