#!/usr/bin/env python3
# RETIRED Day 142 (2026-07-25) — Sigma, branch sigma/retire-clerk-jwt-smoke-hook-day142.
# Retired for THREE reasons, none repairable in place:
#   1. It demanded a smoke report from `node mcp-server/scripts/clerk-jwt-smoke.js`,
#      a script that NEVER EXISTED (mcp-server/scripts/ is empty) — unpassable except by override.
#   2. Its triggers (`git push origin main`, `npx convex deploy --prod`, `npm publish`) were wrong:
#      `--prod` is not a real convex flag. The real prod deploy is
#      `CONVEX_DEPLOY_KEY=<prod> npx convex deploy --yes` (no --prod), so the hook fired
#      FALSELY on those literal strings yet never gated the REAL deploy command. Ineffective.
#   3. The real verification is the G3 post-deploy activation read (a live Clerk request against
#      the deployed env), which makes any pre-deploy smoke redundant.
# Verification is now the G3 post-deploy activation read via the `convex-deploy-dev-then-prod` skill.
# DO NOT re-register. Kept for forensic reference only.
"""
PreToolUse hook: enforce Clerk JWT smoke gate before PROD deploy/publish.

VantagePeers Cloud — Day 108 conformance (BU-specific).

Blocks Bash commands that target PROD (git push origin main,
npx convex deploy --prod, npm publish) unless a recent Clerk JWT
smoke report exists in the workspace at:
    qa/clerk-jwt-smoke-<sha>.json

where <sha> is the current git HEAD short SHA.

Root cause this addresses:
  Clerk JWT token validation failures only surface after deploy when
  no smoke gate is enforced pre-push. VantagePeers Cloud multi-tenant
  auth depends on Clerk issuer + audience claims being correct for
  EVERY production deployment. Silent breakage = all tenants lose MCP
  access simultaneously.

Enforced on:
  - Bash tool calls matching PROD deploy patterns

Patterns blocked (any one triggers the check):
  - git push origin main
  - npx convex deploy --prod
  - npm publish

Pass conditions (any one):
  - File qa/clerk-jwt-smoke-<sha>.json exists in workspace
  - Command contains override marker: // allow-no-clerk-jwt-smoke: <reason>

Exit codes:
  0 = allow
  2 = block with remediation message

Override (rare, one-shot):
  Include `// allow-no-clerk-jwt-smoke: <reason>` in the command.
  Use once, then run the smoke gate and remove the override.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys

WORKSPACE = "/root/coding/vantage-memory"

# PROD deploy patterns — any match triggers the Clerk JWT smoke check
PROD_PATTERNS = [
    re.compile(r"\bgit\s+push\s+origin\s+main\b"),
    re.compile(r"\bnpx\s+convex\s+deploy\s+--prod\b"),
    re.compile(r"\bnpm\s+publish\b"),
]

# Override marker — must have a non-empty reason
OVERRIDE_RE = re.compile(
    r"//\s*allow-no-clerk-jwt-smoke\s*:\s*\S+",
    re.IGNORECASE,
)

STDERR_MSG = """\
BLOCKED: Clerk JWT smoke gate required before PROD deploy (Day 108 — VantagePeers Cloud).

You are targeting a PROD environment but no Clerk JWT smoke report was found
for the current git HEAD in:
    qa/clerk-jwt-smoke-<sha>.json

VantagePeers Cloud is a multi-tenant MCP platform. Clerk JWT issuer/audience
misconfiguration silently breaks ALL tenant connections simultaneously.
A smoke gate verifies the token pipeline end-to-end before every PROD push.

HOW TO RUN THE SMOKE GATE:
  1. Ensure CLERK_SECRET_KEY and CONVEX_URL are set in your shell.
  2. Run:
       cd {workspace}
       SHA=$(git rev-parse --short HEAD)
       node mcp-server/scripts/clerk-jwt-smoke.js > qa/clerk-jwt-smoke-$SHA.json
  3. Inspect the output — confirm issuerMatch and audienceMatch are true.
  4. Retry your deploy command.

OVERRIDE (rare — emergencies only, cite the reason):
  Include this marker verbatim in your command:
    // allow-no-clerk-jwt-smoke: <reason>

  Example:
    git push origin main  # // allow-no-clerk-jwt-smoke: hotfix-no-auth-change

  Use once, then run the smoke gate on the next deploy.
""".format(workspace=WORKSPACE)


def _is_prod_command(command: str) -> bool:
    return any(p.search(command) for p in PROD_PATTERNS)


def _has_override(command: str) -> bool:
    return bool(OVERRIDE_RE.search(command))


def _get_head_sha() -> str | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--short", "HEAD"],
            capture_output=True,
            text=True,
            cwd=WORKSPACE,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return None


def _smoke_report_exists(sha: str) -> bool:
    if not sha:
        return False
    path = os.path.join(WORKSPACE, "qa", f"clerk-jwt-smoke-{sha}.json")
    return os.path.isfile(path)


def main() -> int:
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            return 0
        payload = json.loads(raw)
    except Exception:
        return 0

    try:
        tool_name = payload.get("tool_name") or payload.get("tool") or ""
        if tool_name != "Bash":
            return 0

        tool_input = payload.get("tool_input") or payload.get("input") or {}
        if not isinstance(tool_input, dict):
            return 0

        command = tool_input.get("command") or ""
        if not isinstance(command, str):
            return 0

        if not _is_prod_command(command):
            return 0

        if _has_override(command):
            return 0

        sha = _get_head_sha()
        if sha and _smoke_report_exists(sha):
            return 0

        sys.stderr.write(STDERR_MSG)
        if sha:
            sys.stderr.write(f"Current HEAD SHA: {sha}\n")
            sys.stderr.write(
                f"Expected file:   {WORKSPACE}/qa/clerk-jwt-smoke-{sha}.json\n"
            )
        else:
            sys.stderr.write("(Could not determine git HEAD SHA — not in a git repo?)\n")
        return 2
    except Exception:
        return 0


if __name__ == "__main__":
    sys.exit(main())
