# Convex deployment URL — get this from `npx convex dev` or your Convex dashboard
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex site URL (for HTTP endpoints / webhooks)
# CONVEX_SITE_URL=https://your-deployment-name.convex.site

# GitHub webhook secret (optional — for issue sync via webhooks)
# Set this as a Convex env var: npx convex env set GITHUB_WEBHOOK_SECRET=your-secret
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Set this as a Convex environment variable (not here):
#   npx convex env set AI_GATEWAY_API_KEY=your-key
#
# Used for OpenAI text-embedding-3-small via Vercel AI Gateway.
# Get one at: https://platform.openai.com/api-keys
# AI_GATEWAY_API_KEY=your-openai-api-key
