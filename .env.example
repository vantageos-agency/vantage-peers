# Convex deployment URL — get this from `npx convex dev` or your Convex dashboard
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex site URL (for HTTP endpoints / webhooks)
# CONVEX_SITE_URL=https://your-deployment-name.convex.site

# GitHub webhook secret (optional — for issue sync via webhooks)
# Set this as a Convex env var: npx convex env set GITHUB_WEBHOOK_SECRET=your-secret
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitHub token (optional — for IRP auto-comments on issues)
# Set this as a Convex env var: npx convex env set GITHUB_TOKEN=ghp_your_token
# Needs repo scope to post comments.
# GITHUB_TOKEN=ghp_your_token

# ── Service-account identity for the HTTP MCP server (REQUIRED in production) ──
# The HTTP surface authenticates every bearer-token request by querying Convex
# through a service-account client. That client MINTS a Clerk token before each
# query and REFUSES to send an unauthenticated one — fail-closed by design, so a
# missing variable is a loud 503 rather than a silent anonymous read that
# withOrgScope would treat as master.
#
# Both are required TOGETHER: if either is absent the loader returns null and
# EVERY authenticated MCP call answers
#   {"error":"Authentication service unavailable"}  (503)
# while the unauthenticated /health endpoint keeps answering "ok" — so health is
# NOT evidence that the surface serves anyone.
#
# These are set on the runtime host (Railway service variables), not committed.
# They are named here because a dependency that exists only in the code that
# consumes it is invisible until the first deploy — which is exactly how it
# stayed unnoticed on 2026-07-14..2026-07-21 while no deploy succeeded.
# CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
# CLERK_SERVICE_ACCOUNT_USER_ID=user_your_service_account_user_id
#
# Optional, defaulted in code when unset:
# CLERK_DOMAIN=https://your-tenant.clerk.accounts.dev
# CLERK_JWT_TEMPLATE=convex

# Set this as a Convex environment variable (not here):
#   npx convex env set AI_GATEWAY_API_KEY=your-key
#
# Used for OpenAI text-embedding-3-small via Vercel AI Gateway.
# Get one at: https://platform.openai.com/api-keys
# AI_GATEWAY_API_KEY=your-openai-api-key
